# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Somente no servidor (Vercel > Environment Variables). Nunca exponha no cliente.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Segredo usado pelo cron de limpeza (/api/cleanup). Gere um valor aleatório longo.
CRON_SECRET=troque-por-um-segredo-aleatorio

# Opcional: Cloudflare Turnstile para proteger o login anônimo.
# Deixe vazio em desenvolvimento para pular o CAPTCHA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
